  "main": "dist/main.js",
  "scripts": {
    "test": "pnpx vitest",
    "prepare": "husky",
    "compile": "tsc --build",
    "synth": "pnpm compile && node dist/main.js synth",
    "apply": "pnpm compile && node dist/main.js apply",
    "format": "biome check --write .",
